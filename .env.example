# Copiá este archivo a .env  (cp .env.example .env)
POSTGRES_USER=barber
POSTGRES_PASSWORD=barber
POSTGRES_DB=barber
POSTGRES_PORT=5434

# Cada worktree de la factory usa su propia base: barber_<job-id> (ver factory/repo.md)
DATABASE_URL="postgresql://barber:barber@localhost:5434/barber"

# Secreto para firmar la cookie de sesión (JWT HS256). Mínimo 32 caracteres.
# Generalo con:  openssl rand -base64 32
SESSION_SECRET=

# Carpeta donde se guardan las fotos que suben las barberías (logo, portada, galería).
# Por defecto ./storage/uploads (ignorada por git). En producción (Docker/VPS) TIENE que apuntar
# a un volumen persistente montado fuera de la imagen (ej. /data/uploads), o las fotos se pierden
# al recrear el contenedor. Con varias réplicas el disco local no se comparte.
UPLOADS_DIR=./storage/uploads
